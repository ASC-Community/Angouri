<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Piecewise.fs" />
    <Compile Include="Game.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\content\extended-puzzles.json" LogicalName="Angouri.Kernel.extended-puzzles.json" Condition="Exists('..\content\extended-puzzles.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngouriMath" Version="2.5.0" />
  </ItemGroup>

</Project>
